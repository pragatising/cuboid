{
  "name": "@sragatiping/cuboid-editor",
  "version": "0.0.0",
  "description": "Block editor for Cuboid: one document model, blocks with a Read face and a Write face.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./read": {
      "types": "./dist/read.d.ts",
      "import": "./dist/read.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "dev": "vite --config dev/vite.config.ts",
    "bench": "bench dev --port 5190",
    "prebench": "npm run tokens:theme -w @sragatiping/cuboid-primitives",
    "check:layout": "node scripts/layout-check.mjs"
  },
  "peerDependencies": {
    "@sragatiping/cuboid": "*",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@tiptap/core": "^2.27.0",
    "@tiptap/extension-bubble-menu": "^2.27.0",
    "@tiptap/extension-link": "^2.27.0",
    "@tiptap/extension-placeholder": "^2.27.0",
    "@tiptap/extension-underline": "^2.27.0",
    "@tiptap/pm": "^2.27.0",
    "@tiptap/react": "^2.27.0",
    "@tiptap/starter-kit": "^2.27.0",
    "@tiptap/suggestion": "^2.27.0"
  },
  "devDependencies": {
    "@sragatiping/bench": "*",
    "@sragatiping/cuboid": "*",
    "@sragatiping/cuboid-primitives": "*",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "jsdom": "^30.1.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vitest": "^3.2.7"
  }
}
