{
  "name": "@sragatiping/cuboid",
  "version": "0.1.10",
  "description": "Cube \u2014 React components and design tokens for data views, tables, and themed UI.",
  "keywords": [
    "react",
    "cube",
    "design-system",
    "json",
    "table",
    "visualization",
    "tokens"
  ],
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js",
      "types": "./dist/index.d.ts"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config dev/vite.config.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "type-check:shell": "tsc --noEmit -p dev",
    "test": "vitest run",
    "check:icons": "node scripts/check-icon-imports.mjs",
    "a11y:sweep": "node scripts/a11y-sweep.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens:theme": "npm run tokens:theme -w @sragatiping/cuboid-primitives",
    "prebuild": "npm run tokens:theme",
    "prepublishOnly": "npm run build",
    "predev": "npm run tokens:theme && npm run build:components-json && npm run build:models && npm run build:status",
    "prestorybook": "npm run tokens:theme",
    "prebuild-storybook": "npm run tokens:theme",
    "test:watch": "vitest",
    "generate:css-properties": "node scripts/generate-css-properties.mjs",
    "build:components-json": "node scripts/build-components-json.mjs",
    "build:models": "vite-node scripts/build-models.ts",
    "build:status": "vite-node scripts/build-status.ts",
    "pretype-check:shell": "npm run build:components-json && npm run build:models && npm run build:status"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/addon-interactions": "^8.6.18",
    "@storybook/addon-onboarding": "^8.6.18",
    "@storybook/blocks": "^8.6.18",
    "@storybook/react": "^8.6.18",
    "@storybook/react-vite": "^8.6.18",
    "@storybook/test": "^8.6.18",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "storybook": "^8.6.18",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "vite-plugin-dts": "^4.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@sragatiping/cuboid-primitives": "*",
    "@tanstack/react-table": "^8.21.3",
    "clsx": "^2.1.1"
  }
}
