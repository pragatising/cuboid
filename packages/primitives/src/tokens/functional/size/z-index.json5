{
  zIndex: {
    base: {
      $value: '{base.zIndex.0}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    raised: {
      $value: '{base.zIndex.100}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    sticky: {
      $value: '{base.zIndex.200}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    dropdown: {
      $value: '{base.zIndex.300}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    overlay: {
      $value: '{base.zIndex.400}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    sheet: {
      $value: '{base.zIndex.500}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    dialog: {
      $value: '{base.zIndex.600}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    popover: {
      // Above dialog(600): a popover (menu, dropdown panel) must be able to
      // render above an open dialog that triggered it. Below tooltip: a
      // tooltip frequently appears nested inside a popover (hovering an
      // item inside an open menu) and must out-rank it — confirmed against
      // Chakra UI, Material UI, Ant Design, and Primer's own z-index
      // scales, which unanimously stack tooltip above popover.
      $value: '{base.zIndex.700}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    tooltip: {
      $value: '{base.zIndex.800}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    toast: {
      // Highest named layer below `max`: a toast is a global, app-level
      // notification that must never be hidden by anything else the app
      // renders, including a tooltip — matching Bootstrap's and Ant
      // Design's "toast/notification outranks everything" precedent
      // (Ant Design places its notification layer far above its own
      // modal/popover/tooltip cluster for the same reason).
      $value: '{base.zIndex.900}',
      $type: 'number',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
    max: {
      $value: 9999,
      $type: 'number',
      $description: 'Ceiling value for elements that must always render above everything else. Intentionally outside the step scale.',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['zIndex'] } },
    },
  },
}
