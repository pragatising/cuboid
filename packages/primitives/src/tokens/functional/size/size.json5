{
  size: {
    // The raw size scale, keyed as multiples of the 8px base unit.
    //
    // Why Nx and not xs/sm/md/lg: those names mean DIFFERENT values on
    // different scales (radius.medium was 8px while space.md was 12px), so a
    // shared vocabulary implied a shared scale that did not exist. An Nx key
    // IS its value -- 3x is always 24px, on every scale -- which removes the
    // collision and the per-component translation tables it forced.
    //
    // Every step maps to a clean eighth (verified across all 74 base steps),
    // so sub-unit values are exact: 0.125x = 1px, 0.5x = 4px.
    //
    // Merged from the former display-sizes.json5, which declared the same
    // `size:` root and therefore always merged into this tree at build time --
    // two files, one namespace. Semantic aliases (space.*, borderRadius.*)
    // reference these steps and carry intent; this file carries the scale.

    '0': {
      $value: '{base.size.0}',
      $type: 'dimension',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['size', 'gap'] } },
    },
    '1': {
      $value: '{base.size.1}',
      $type: 'dimension',
      $extensions: { 'org.cuboid.figma': { collection: 'functional/size', scopes: ['size', 'gap'] } },
