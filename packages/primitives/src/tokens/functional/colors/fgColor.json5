      },
      subtle: {
        $value: '{base.color.gray.7}',
        $type: 'color',
        $description: 'Passes 4.5:1 on canvas.default in both modes (gray.6 was 2.3:1). It now shares gray.7 with muted: tell them apart by use, not by shade. Disabled text uses neutral.disabled, not this.',
