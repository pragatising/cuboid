{
  syntax: {
    $description: 'Language-specific syntax highlighting colors. Each language carries only the token categories that apply to its own grammar.',
    json: {
      key: { $value: '{base.color.gray.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      string: { $value: '{base.color.red.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      numberLiteral: { $value: '{base.color.blue.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      booleanLiteral: { $value: '{base.color.purple.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      nullLiteral: { $value: '{base.color.gray.4}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      bracket: {
        $value: '#E01280',
        $type: 'color',
        $description: 'GAP: no base color step matches this magenta/pink. Add a base color and alias this once added.',
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#f33190' } },
      },
      bracketNested: { $value: '{base.color.purple.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
    },
    typescript: {
      // Comments
      comment: {
        $value: '#537742',
        $type: 'color',
        $description: "A line comment or a block comment. Dark is the VS Code Dark+ colour (#6A9955). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#6A9955' } },
      },
      docComment: {
        $value: '#537742',
        $type: 'color',
        $description: "A JSDoc comment: darker than a comment, since it is documentation that is meant to be read. Dark is the VS Code Dark+ colour (#6A9955). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#6A9955' } },
      },
      docTag: {
        $value: '#2672B1',
        $type: 'color',
        $description: "The `@param`, `@returns` and `@type` of a doc comment. Dark is the VS Code Dark+ colour (#569CD6). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#569CD6' } },
      },
      // Keywords
      keyword: {
        $value: '#A848A0',
        $type: 'color',
        $description: "Control flow and modules: `import`, `export`, `from`, `return`, `if`, `else`, `for`, `await`, `throw`, `typeof`, `in`, `new`. Magenta, as VS Code Light+ draws them.9:1 on the code surface in light but Dark is the VS Code Dark+ colour (#C586C0). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#C586C0' } },
      },
      storage: {
        $value: '#2672B1',
        $type: 'color',
        $description: "Declarations and modifiers: `const`, `let`, `var`, `function`, `class`, `interface`, `type`, `enum`, `extends`, `public`, `readonly`, `this`. Dark is the VS Code Dark+ colour (#569CD6). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#569CD6' } },
      },
      // Names
      functionCall: {
        $value: '#727212',
        $type: 'color',
        $description: "A function or method being called (`useState(\u2026)`, `items.map(\u2026)`). Deep purple:9:1 on the code surface in light. Dark is the VS Code Dark+ colour (#DCDCAA). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#DCDCAA' } },
      },
      functionDeclaration: {
        $value: '#727212',
        $type: 'color',
        $description: "The name of a function where it is declared. Dark is the VS Code Dark+ colour (#DCDCAA). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#DCDCAA' } },
      },
      typeName: {
        $value: '#1C7C68',
        $type: 'color',
        $description: "A type, interface, class, enum or a TypeScript primitive in a type position. The same teal as a component tag, since a component is a type. Dark is the VS Code Dark+ colour (#4EC9B0). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#4EC9B0' } },
      },
      propertyAccess: {
        $value: '#0073B1',
        $type: 'color',
        $description: "A property: `row.name`, and the key of an object literal. Dark is the VS Code Dark+ colour (#9CDCFE). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#9CDCFE' } },
      },
      parameter: {
        $value: '#0073B1',
        $type: 'color',
        $description: "A function's parameter. Dark is the VS Code Dark+ colour (#9CDCFE). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#9CDCFE' } },
      },
      constant: {
        $value: '#0074B2',
        $type: 'color',
        $description: "A constant: an `UPPER_CASE` value, an enum member. Dark is the VS Code Dark+ colour (#4FC1FF). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#4FC1FF' } },
      },
      // Literals
      string: {
        $value: '#AB5634',
        $type: 'color',
        $description: "A string or template literal's text.9:1 in light and Dark is the VS Code Dark+ colour (#CE9178). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#CE9178' } },
      },
      stringEscape: {
        $value: '#8D6718',
        $type: 'color',
        $description: "An escape inside a string: `\\n`, `\\u00e9`. Dark is the VS Code Dark+ colour (#D7BA7D). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#D7BA7D' } },
      },
      stringRegexp: {
        $value: '#C43F3F',
        $type: 'color',
        $description: "A regular expression.2:1 in light and Dark is the VS Code Dark+ colour (#D16969). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#D16969' } },
      },
      stringUrl: {
        $value: '#AB5634',
        $type: 'color',
        $description: "A string that is a URL. Dark is the VS Code Dark+ colour (#CE9178). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#CE9178' } },
      },
      stringEmail: {
        $value: '#AB5634',
        $type: 'color',
        $description: "A string that is an email address. Dark is the VS Code Dark+ colour (#CE9178). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#CE9178' } },
      },
      stringUuid: {
        $value: '#AB5634',
        $type: 'color',
        $description: "A string that is a UUID: a quiet identifier. Dark is the VS Code Dark+ colour (#CE9178). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#CE9178' } },
      },
      templateInterpolation: {
        $value: '#2672B1',
        $type: 'color',
        $description: "The dollar sign and curly brackets that open and close an expression inside a template literal, in the keyword colour: it is where code starts again. Dark is the VS Code Dark+ colour (#569CD6). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#569CD6' } },
      },
      numberLiteral: {
        $value: '#447B27',
        $type: 'color',
        $description: "A number.2:1 in light and Dark is the VS Code Dark+ colour (#B5CEA8). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#B5CEA8' } },
      },
      booleanLiteral: {
        $value: '#2672B1',
        $type: 'color',
        $description: "`true` and `false`. Dark is the VS Code Dark+ colour (#569CD6). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#569CD6' } },
      },
      nullLiteral: {
        $value: '#2672B1',
        $type: 'color',
        $description: "`null`, `undefined`, `NaN` and `Infinity`. Dark is the VS Code Dark+ colour (#569CD6). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#569CD6' } },
      },
      // Punctuation
      operator: {
        $value: '{fgColor.neutral.default}',
        $type: 'color',
        $description: "`=`, `=>`, `+`, `&&`, `?`, `.`: the signs between values. Dark is the VS Code Dark+ colour (#D4D4D4). Light is the same hue, darkened to 4.6:1 on the light code surface (the text colour).",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#D4D4D4' } },
      },
      punctuation: {
        $value: '{fgColor.neutral.default}',
        $type: 'color',
        $description: "`,` `;` and `:`: separators, quieter than an operator. Dark is the VS Code Dark+ colour (#D4D4D4). Light is the same hue, darkened to 4.6:1 on the light code surface (the text colour).",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#D4D4D4' } },
      },
      bracketLevel1: {
        $value: '#816D00',
        $type: 'color',
        $description: "A `(`, `[` or `{` and its closing partner, at the first level of nesting. Level 1, 2 and 3 repeat, so a pair is found by its colour.8:1 in light and Dark is the VS Code Dark+ colour (#FFD700). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#FFD700' } },
      },
      bracketLevel2: {
        $value: '#BC28B7',
        $type: 'color',
        $description: "A bracket pair, second level. Dark is the VS Code Dark+ colour (#DA70D6). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#DA70D6' } },
      },
      bracketLevel3: {
        $value: '#0071C1',
        $type: 'color',
        $description: "A bracket pair, third level. Dark is the VS Code Dark+ colour (#179FFF). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#179FFF' } },
      },
      // JSX
      componentTag: {
        $value: '#1C7C68',
        $type: 'color',
        $description: "The name of a component (`Button`, `ActionMenu.Item`), in both its opening and closing tag, and the `<`, `</`, `>` and `/>` around it. 7.5:1 on the code surface in both modes (49:1 in light). Dark is the VS Code Dark+ colour (#4EC9B0). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#4EC9B0' } },
      },
      htmlTag: {
        $value: '#2672B1',
        $type: 'color',
        $description: "The name of a platform element (`div`, `span`), and the `<`, `</`, `>` and `/>` around it. Dark red, as Light+ draws tags. Dark is the VS Code Dark+ colour (#569CD6). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#569CD6' } },
      },
      tagBracket: {
        $value: '#6E6E6E',
        $type: 'color',
        $description: "A tag's `<`, `</`, `>` and `/>` where the tag it belongs to is not known: they take their tag's colour whenever it is. Dark is the VS Code Dark+ colour (#898989) lifted from Dark+'s #808080, which is 4.1:1 on the dark code surface. Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#898989' } },
      },
      jsxAttribute: {
        $value: '#0073B1',
        $type: 'color',
        $description: "The name of a prop. orange.7 (the HTML attribute colour) is 2.8:1 on the code surface; this step passes in both modes. Dark is the VS Code Dark+ colour (#9CDCFE). Light is the same hue, darkened to 4.6:1 on the light code surface.",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#9CDCFE' } },
      },
      jsxText: {
        $value: '{fgColor.neutral.default}',
        $type: 'color',
        $description: "The text between an element's tags. Dark is the VS Code Dark+ colour (#D4D4D4). Light is the same hue, darkened to 4.6:1 on the light code surface (the text colour).",
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#D4D4D4' } },
      },
      constantOtherReferenceLink: {
        $value: '#0a3069',
        $type: 'color',
        $description: 'GAP: no base color step matches this dark navy. Add a base color and alias this once added.',
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#c5e1ff' } },
      },
    },
    html: {
      comment: { $value: '{base.color.gray.7}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      entityTag: { $value: '{base.color.mag.9}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      attributeName: { $value: '{base.color.orange.7}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      string: { $value: '{base.color.red.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      bracket: {
        $value: '#E01280',
        $type: 'color',
        $description: 'GAP: no base color step matches this magenta/pink. Add a base color and alias this once added.',
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#f33190' } },
      },
    },
    css: {
      comment: { $value: '{base.color.gray.7}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      cssSelector: { $value: '{base.color.lime.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      cssProperty: { $value: '{base.color.gray.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      cssValue: { $value: '{base.color.orange.9}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      string: { $value: '{base.color.red.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      numberLiteral: { $value: '{base.color.blue.8}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      bracket: {
        $value: '#E01280',
        $type: 'color',
        $description: 'GAP: no base color step matches this magenta/pink. Add a base color and alias this once added.',
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' }, 'org.cuboid.overrides': { dark: '#f33190' } },
      },
    },
    markdown: {
      bold: { $value: '{base.color.gray.9}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      italic: { $value: '{base.color.gray.9}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      heading: {
        $value: '#09B2B5',
        $type: 'color',
        $description: 'GAP: no base color step matches this teal/cyan. Add a base color and alias this once added.',
        $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } },
      },
      list: { $value: '{base.color.green.6}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      link: { $value: '{base.color.indigo.9}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      inserted: {
        bg: { $value: '{base.color.green.0}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
        text: { $value: '{base.color.green.6}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      },
      deleted: {
        bg: { $value: '{base.color.red.0}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
        text: { $value: '{base.color.red.7}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      },
      changed: {
        bg: { $value: '{base.color.orange.1}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
        text: { $value: '{base.color.orange.6}', $type: 'color', $extensions: { 'org.cuboid.figma': { collection: 'mode', group: 'syntax' } } },
      },
    },
  },
}
