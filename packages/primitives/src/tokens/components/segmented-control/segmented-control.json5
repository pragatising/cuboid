{
  segmentedControl: {
    bgColor: {
      $value: '{bgColor.neutral.light.3}',
      $type: 'color',
      $description: 'The strip the items sit in (Figma 5008:52715). Figma canvas/insetStrong is #f3f2f0, one step off neutral.light.3 (#f4f4f2) and lighter than the repo canvas.insetStrong (#efeeea), which an item hovered on the strip must differ from.',
      $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'segmentedControl' } },
    },
    item: {
      fgColor: {
        rest: {
          $value: '{fgColor.neutral.default}',
          $type: 'color',
          $description: 'An unselected item, on the strip (Figma button/ghost/fgcolor/rest, #525252): the ghost button reads muted (#6f6f6d) everywhere else, but on the strip an unselected item is as dark as the chosen one.',
          $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'segmentedControl' } },
        },
      },
      bgColor: {
        hover: {
          $value: '{bgColor.neutral.light.4}',
          $type: 'color',
          $description: 'An unselected item under the pointer (Figma button/ghost/bgcolor/hover, #efeeea): a step darker than the strip.',
          $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'segmentedControl' } },
        },
      },
    },
    sizes: {
      padding: { $value: '{size.2}', $type: 'dimension', $description: 'Between the strip and its items, and between the items.', $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'segmentedControl' } } },
      borderRadius: { $value: '{borderRadius.md}', $type: 'dimension', $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'segmentedControl' } } },
    },
  },
}
