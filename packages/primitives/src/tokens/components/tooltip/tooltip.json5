{
  "tooltip": {
    "color": {
      "background": {
        "$value": "{bgColor.neutral.inverted.1}",
        "$type": "custom-string",
        "$description": "Raw CSS value with no token equivalent (viewport units / min() are outside DTCG's dimension type).",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "border": {
        "$value": "{bgColor.canvas.transparent}",
        "$type": "color",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "foreground": {
        "$value": "{fgColor.neutral.inverted}",
        "$type": "color",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      }
    },
    "sizes": {
      "gap": {
        "$value": "{size.2}",
        "$type": "dimension",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "borderRadius": {
        "$value": "{borderRadius.sm}",
        "$type": "dimension",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "paddingInline": {
        "$value": "{size.6}",
        "$type": "dimension",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "paddingBlock": {
        "$value": "{size.2}",
        "$type": "dimension",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "maxWidth": {
        "$value": "{size.240}",
        "$type": "dimension",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "maxWidthSingleLine": {
        "$value": "{size.120}",
        "$type": "dimension",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "boxShadow": {
        "$value": "{shadow.floating.sm}",
        "$type": "custom-string",
        "$description": "Raw CSS value with no token equivalent (viewport units / min() are outside DTCG's dimension type).",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      }
    },
    "delay": {
      "$description": "How long the pointer must rest on the trigger before the tooltip shows: short for a hint on something familiar, medium for most, long where a tooltip would get in the way. Focus from the keyboard shows it at once.",
      "short": {
        "$value": "{base.duration.50}",
        "$type": "duration",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "medium": {
        "$value": "{base.duration.400}",
        "$type": "duration",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      },
      "long": {
        "$value": "{base.duration.1200}",
        "$type": "duration",
        "$extensions": {
          "org.cuboid.figma": {
            "collection": "component",
            "group": "tooltip"
          }
        }
      }
    }
  }
}
