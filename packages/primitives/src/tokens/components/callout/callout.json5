{
  callout: {
    bgColor: {
      $value: '{bgColor.canvas.inset}',
      $type: 'color',
      $description: 'Default background for Callout when no background prop is passed. Any GlobalColorPath can override it at the component level — the variants below are presets, not a fence.',
      $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
    },
    fgColor: {
      $value: '{fgColor.neutral.default}',
      $type: 'color',
      $description: 'Default foreground for Callout when no foreground prop is passed. Any GlobalColorPath can override it at the component level — the variants below are presets, not a fence.',
      $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
    },
    info: {
      bgColor: {
        $value: '{display.highlight.blue}',
        $type: 'color',
        $description: 'Callout surface for variant "info": the saturated blue, the same as the Highlight component.',
        $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
      },
      fgColor: {
        $value: '{fgColor.neutral.contrast}',
        $type: 'color',
        $description: 'Callout text for variant "info": the high-contrast neutral foreground.',
        $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
      },
    },
    caution: {
      bgColor: {
        $value: '{display.orange.scale.1}',
        $type: 'color',
        $description: 'Callout surface for variant "caution": the orange, the same as the Highlight component.',
        $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
      },
      fgColor: {
        $value: '{fgColor.neutral.contrast}',
        $type: 'color',
        $description: 'Callout text for variant "caution": the high-contrast neutral foreground.',
        $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
