{
  callout: {
    bgColor: {
      $value: '{bgColor.canvas.inset}',
      $type: 'color',
      $description: 'Default background for Callout when no background prop is passed. Any bgColor token or CSS colour can override it at the component level with the backgroundColor prop.',
      $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
    },
    fgColor: {
      $value: '{fgColor.neutral.default}',
      $type: 'color',
      $description: 'Default foreground for Callout when no color prop is passed. Any fgColor token or CSS colour can override it with the color prop.',
      $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
    },
    paddingInline: {
      $value: '{space.sm}',
      $type: 'dimension',
      $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
    },
    paddingBlock: {
      $value: '{space.xs}',
      $type: 'dimension',
      $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
    },
    borderRadius: {
      $value: '{borderRadius.md}',
      $type: 'dimension',
      $extensions: { 'org.cuboid.figma': { collection: 'component', group: 'callout' } },
    },
  },
}
