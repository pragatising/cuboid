{
  iconButton: {
    outlined: {
      default: {
        bgColor: {
          rest: { $value: '{bgColor.neutral.light.1}', $type: 'color' },
          hover: { $value: '{bgColor.neutral.light.2}', $type: 'color' },
          pressed: { $value: '{bgColor.neutral.light.4}', $type: 'color' },
          disabled: { $value: '{bgColor.neutral.light.4}', $type: 'color' },
        },
        borderColor: {
          rest: { $value: '{borderColor.subtle}', $type: 'color' },
          hover: { $value: '{borderColor.subtle}', $type: 'color' },
          pressed: { $value: '{borderColor.subtle}', $type: 'color' },
          disabled: {
            $value: '{borderColor.subtle}',
            $type: 'color',
            $description: 'GAP: original used borderColor.muted, lighter than gray.3 (borderColor.subtle, the lightest named functional step). Falls back to subtle.',
          },
        },
        fgColor: {
          rest: { $value: '{fgColor.neutral.default}', $type: 'color' },
          hover: { $value: '{fgColor.neutral.default}', $type: 'color' },
          pressed: { $value: '{fgColor.neutral.default}', $type: 'color' },
          disabled: { $value: '{fgColor.neutral.disabled}', $type: 'color' },
        },
      },
      selected: {
        bgColor: {
          rest: { $value: '{bgColor.informational.subtle}', $type: 'color' },
          hover: { $value: '{bgColor.informational.strong}', $type: 'color' },
          pressed: { $value: '{bgColor.informational.muted}', $type: 'color' },
          disabled: { $value: '{bgColor.neutral.light.3}', $type: 'color' },
        },
        borderColor: {
          rest: { $value: '{borderColor.informational.strong}', $type: 'color' },
          hover: { $value: '{borderColor.informational.strong}', $type: 'color' },
          pressed: { $value: '{borderColor.informational.strong}', $type: 'color' },
          disabled: {
            $value: '{borderColor.subtle}',
            $type: 'color',
            $description: 'GAP: original used borderColor.subtle, lighter than gray.3 (borderColor.subtle, the lightest named functional step). Falls back to subtle.',
          },
        },
        fgColor: {
          rest: { $value: '{fgColor.informational.strong}', $type: 'color' },
          hover: { $value: '{fgColor.informational.strong}', $type: 'color' },
          pressed: { $value: '{fgColor.informational.strong}', $type: 'color' },
          disabled: { $value: '{fgColor.neutral.disabled}', $type: 'color' },
        },
      },
    },
  },
}
