{
  highlight: {
    none: {
      bgColor: { $value: '{bgColor.canvas.transparent}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.subtle}', $type: 'color' },
    },
    neutral: {
      bgColor: { $value: '{bgColor.neutral.light.3}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.contrast}', $type: 'color' },
    },
    green: {
      bgColor: { $value: '{display.highlight.green}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.contrast}', $type: 'color' },
    },
    blue: {
      bgColor: { $value: '{display.highlight.blue}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.contrast}', $type: 'color' },
    },
    yellow: {
      bgColor: { $value: '{display.highlight.yellow}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.contrast}', $type: 'color' },
    },
    orange: {
      bgColor: { $value: '{display.orange.1}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.contrast}', $type: 'color' },
    },
    red: {
      bgColor: { $value: '{display.red.3}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.contrast}', $type: 'color' },
    },
    lime: {
      bgColor: { $value: '{display.highlight.lime}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.contrast}', $type: 'color' },
    },
    purple: {
      bgColor: { $value: '{display.highlight.purple}', $type: 'color' },
      fgColor: { $value: '{fgColor.neutral.contrast}', $type: 'color' },
    },
  },
}
