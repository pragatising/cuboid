{
  keybindingHint: {
    color: {
      normal: {
        fgColor: { $value: '{fgColor.neutral.muted}', $type: 'color' },
        bgColor: { $value: '{bgColor.canvas.transparent}', $type: 'color' },
        borderColor: { $value: '{borderColor.default}', $type: 'color' },
      },
      inverted: {
        $description: 'For a dark surface in light mode (and a light one in dark mode), such as a tooltip.',
        fgColor: { $value: '{fgColor.neutral.inverted}', $type: 'color' },
        bgColor: { $value: '{bgColor.neutral.inverted.3}', $type: 'color' },
        borderColor: { $value: '{bgColor.canvas.transparent}', $type: 'color' },
      },
    },
    sizes: {
      gap: { $value: '{size.4}', $type: 'dimension' },
      sm: {
        padding: { $value: '{size.2}', $type: 'dimension' },
        minWidth: { $value: '{size.16}', $type: 'dimension' },
        borderRadius: { $value: '{borderRadius.xs}', $type: 'dimension' },
      },
      md: {
        padding: { $value: '{size.4}', $type: 'dimension' },
        minWidth: { $value: '{size.20}', $type: 'dimension' },
        borderRadius: { $value: '{borderRadius.sm}', $type: 'dimension' },
      },
    },
  },
}
