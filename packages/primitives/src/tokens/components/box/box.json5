  box: {
    $description: 'Box has no component-specific token values. Its colour props resolve against the functional bgColor / borderColor / fgColor tokens, borderRadius against borderRadius.*, spacing against size.* (Nx scale) and space.* (semantic ladder), z-index against zIndex.*, and its border width is borderWidth.thin. Kept as a record that Box was audited.',
  },
}
