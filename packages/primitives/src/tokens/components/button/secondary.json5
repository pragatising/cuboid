{
  button: {
    secondary: {
      bgColor: {
        rest: { $value: '{bgColor.neutral.light.1}', $type: 'color' },
        hover: { $value: '{bgColor.neutral.light.2}', $type: 'color' },
        pressed: { $value: '{bgColor.neutral.light.4}', $type: 'color' },
        disabled: { $value: '{bgColor.neutral.light.3}', $type: 'color' },
      },
      borderColor: {
        rest: { $value: '{borderColor.subtle}', $type: 'color' },
        hover: { $value: '{borderColor.subtle}', $type: 'color' },
        pressed: { $value: '{borderColor.subtle}', $type: 'color' },
        disabled: {
          $value: '{borderColor.subtle}',
          $type: 'color',
          $description: 'GAP: original used borderColor.subtle, lighter than gray.3 (borderColor.subtle, the lightest named functional step). Falls back to subtle — disabled currently looks identical to rest/hover/pressed instead of fainter.',
        },
      },
      fgColor: {
        rest: { $value: '{fgColor.neutral.default}', $type: 'color' },
        hover: { $value: '{fgColor.neutral.default}', $type: 'color' },
        pressed: { $value: '{fgColor.neutral.subtle}', $type: 'color' },
        disabled: { $value: '{fgColor.neutral.disabled}', $type: 'color' },
      },
    },
  },
}
