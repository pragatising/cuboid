{
  button: {
    primary: {
      bgColor: {
        rest: { $value: '{bgColor.neutral.inverted.3}', $type: 'color' },
        hover: { $value: '{bgColor.neutral.inverted.2}', $type: 'color' },
        pressed: { $value: '{bgColor.neutral.inverted.1}', $type: 'color' },
        disabled: { $value: '{bgColor.neutral.light.4}', $type: 'color' },
      },
      borderColor: {
        rest: { $value: '{borderColor.transparent}', $type: 'color' },
        hover: { $value: '{borderColor.transparent}', $type: 'color' },
        pressed: { $value: '{borderColor.transparent}', $type: 'color' },
        disabled: { $value: '{borderColor.transparent}', $type: 'color' },
      },
      fgColor: {
        rest: { $value: '{fgColor.neutral.inverted}', $type: 'color' },
        hover: { $value: '{fgColor.neutral.inverted}', $type: 'color' },
        pressed: { $value: '{fgColor.neutral.inverted}', $type: 'color' },
        disabled: { $value: '{fgColor.neutral.disabled}', $type: 'color' },
      },
    },
  },
}
