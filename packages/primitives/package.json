{
  "name": "@sragatiping/cuboid-primitives",
  "version": "0.1.10",
  "description": "Design tokens and the token build pipeline for Cuboid. No React dependency, by design.",
  "type": "module",
  "scripts": {
    "tokens:functional-colors": "node scripts/flatten-functional-colors.mjs",
    "tokens:functional-typography": "node scripts/flatten-functional-typography.mjs",
    "tokens:theme": "node scripts/buildTokens.ts",
    "validate:tokens": "node scripts/validateTokens.ts",
    "check:no-react": "node scripts/check-no-react.mjs",
    "test": "npm run check:no-react && npm run typecheck && node --test \"src/**/*.test.ts\" \"scripts/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "icons:extract": "node scripts/icons/extract-figma-icons.mjs",
    "icons:sync": "node scripts/icons/sync-icons.mjs",
    "icons": "npm run icons:extract && npm run icons:sync"
  },
  "dependencies": {
    "color2k": "^2.0.4",
    "colorjs.io": "^0.5.2",
    "json5": "^2.2.3",
    "style-dictionary": "^5.5.3",
    "zod": "^4.6.3"
  },
  "devDependencies": {
    "@material-symbols-svg/react": "^0.9.0",
    "@types/node": "^26.5.1",
    "typescript": "^5.9.3"
  },
  "exports": {
    ".": "./dist/js/tokens.js",
    "./tokens.json": "./dist/tokens.json",
    "./tokens.js": "./dist/js/tokens.js",
    "./css/theme.css": "./dist/css/theme.css",
    "./css/*": "./dist/css/*",
    "./applyOverrides": "./src/applyOverrides.ts",
    "./package.json": "./package.json",
    "./icons/icon-fonts.css": "./icons/icon-fonts.css",
    "./icons/fonts/*": "./icons/fonts/*",
    "./icons/names": "./icons/material/iconNames.generated.js",
    "./icons/manifest.json": "./icons/manifest.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "icons",
    "src/tokens",
    "src/applyOverrides.ts"
  ]
}
